#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/KKIBoat.proto"
EXTERNPROTO "../protos/BuoyRed.proto"
EXTERNPROTO "../protos/BuoyGreen.proto"
EXTERNPROTO "../protos/BuoyBlue.proto"
EXTERNPROTO "../protos/TargetDock.proto"

WorldInfo {
  basicTimeStep 16
  coordinateSystem "ENU"
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.32 0.14 0.94 2.5
  position 14.0 -18.0 12.0
}
DirectionalLight {
  direction 0.3 0.6 -1.0
  intensity 2.5
  castShadows TRUE
}
Background {
  skyColor [
    0.45 0.72 0.92
  ]
}

# --- POOL FLOOR (30m x 30m) ---
DEF POOL_FLOOR Solid {
  name "pool_floor"
  translation 0 0 -0.85
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.72 0.75 0.80
        roughness 0.9
      }
      geometry Box {
        size 30 30 0.10
      }
    }
  ]
  boundingObject Box {
    size 30 30 0.10
  }
}

# --- WATER FLUID VOLUME (Top surface at Z = 0.0) ---
DEF WATER Fluid {
  name "water"
  translation 0 0 -0.40
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.08 0.55 0.75
        transparency 0.65
        roughness 0.2
        metalness 0.1
      }
      geometry DEF WATER_BOX Box {
        size 30 30 0.80
      }
    }
  ]
  viscosity 0.001
  density 1000
  boundingObject USE WATER_BOX
  locked TRUE
}

