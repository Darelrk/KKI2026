# Copy to /etc/asv-dashboard.env and protect with chmod 600.
ASV_ID=default
ASV_BACKEND_HOST=0.0.0.0
ASV_BACKEND_PORT=8080
# Browser-compatible raw surface camera URL (20–30 FPS), if the camera
# source is hosted separately from this bridge. Leave empty until verified.
ASV_STREAM_URL=
# Comma-separated browser origins allowed to read direct live API responses.
# For remote runtime, replace the placeholder with the exact production Vercel
# origin and keep http://localhost:3001 only when local development needs it.
# Never use a wildcard (*); this allowlist is not an authentication mechanism.
ASV_CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3001
# The bridge fallback/debug endpoint is /stream.mjpg; it is not the main feed.
ASV_FALLBACK_MAX_BASE64=180000
ASV_FALLBACK_MAX_FPS=1
ASV_FRAME_WAIT_TIMEOUT=1

# Remote browser control is fail-closed by default. Enable it only on a Pi
# explicitly configured with ASV_PIXHAWK_ENABLED=true and exact CORS origins.
ASV_REMOTE_CONTROL_ENABLED=false
ASV_REMOTE_COMMAND_TIMEOUT=0.5
# ASV_CONTROL_TOKEN remains Pi-only for the existing model actuator path; never
# copy it into a frontend bundle or expose it through the remote browser app.
# Pixhawk telemetry is disabled in this generic example. Remote runtime
# requires ASV_PIXHAWK_ENABLED=true on the explicitly configured Pi; no arm,
# mode change, navigation, or RC command is enabled by this example.
ASV_PIXHAWK_ENABLED=false
ASV_PIXHAWK_ENDPOINT=/dev/ttyACM0
ASV_PIXHAWK_BAUD=115200
ASV_PIXHAWK_UPDATE_HZ=1
ASV_PIXHAWK_HEARTBEAT_TIMEOUT=3
ASV_PIXHAWK_TRACK_MAX_POINTS=500
ASV_PIXHAWK_RECONNECT_SECONDS=3

